{
  "name": "markdown-notes",
  "private": true,
  "version": "1.1.0",
  "description": "知页：离线优先的个人 Markdown 笔记与知识管理工具",
  "productName": "知页",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/licenses.mjs && node scripts/package.mjs",
    "bench": "tsx scripts/benchmark.ts",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write src tests scripts *.json *.mts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@streamparser/json": "0.0.26",
    "dompurify": "3.4.17",
    "lucide-react": "1.60.0",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
